# Environment variables: load through your IDE or process environment, not committed credentials.
SPRING_PROFILES_ACTIVE=local
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For dev/root MySQL profiles:
DB_URL=
DB_USERNAME=
DB_PASSWORD=
GEMINI_API_KEY=
# Latest alias requested by the project; validate before release.
GEMINI_MODEL=gemini-flash-latest
WEATHER_API_KEY=
EDGE_API_KEY=
IOT_ENVIRONMENT=SIMULATED
# Only nodes with reviewed GROW_LIGHT/WATER_PUMP hardware and local cutoff firmware.
IOT_APPROVED_NODES=
# JSON object: node code -> SHA-256 hash of a unique random device secret.
IOT_NODE_KEY_HASHES={}
WALLET_DOMAIN=localhost:5173
REWARDS_ENABLED=false
# JSON object keyed by plant ID; server-approved humidityMin/humidityMax/lightMin in percent.
REWARD_RULES={}
SEPOLIA_RPC_URL=
SEPOLIA_CONTRACT=
SEPOLIA_MINTER_KEY=

# Optional one-time admin creation, minimum 16 characters; disable after bootstrap.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
